{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coomwall",
  "version": "1.0.2",
  "identifier": "com.coomwall.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "coomwall",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#111418",
        "visible": false,
        "generalAutofillEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: cw: http://cw.localhost https:; media-src 'self' blob: cw: http://cw.localhost https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../target/release/WebView2Loader.dll": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1RUJCMUU1OTYxQ0NGRUEKUldUcXp4eVc1YkhydGJYL2VIK0s4Z0RUTTNuclVYcDVzT21WQ04wNVZ1YkVXQlNib2tBZEtSWDgK",
      "endpoints": [
        "https://github.com/kpg-anon/coomwall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
